{
  "opencollection": "1.0.0",
  "info": {
    "name": "Biolevate Agent Multi-Dimensional Extraction API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Multi-Dimensional Extraction",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List multi-dimensional extraction jobs",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "/api/core/multi-dim-extraction/jobs",
            "params": [
              {
                "name": "pageSize",
                "value": "",
                "type": "query",
                "description": "Page size"
              },
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "Page number"
              },
              {
                "name": "sortProperty",
                "value": "",
                "type": "query",
                "description": "Sort property"
              },
              {
                "name": "sortOrder",
                "value": "",
                "type": "query",
                "description": "Sort order"
              }
            ]
          },
          "docs": "Returns a paginated list of multi-dimensional extraction jobs for the current user"
        },
        {
          "info": {
            "name": "Create multi-dimensional extraction job",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "/api/core/multi-dim-extraction/jobs",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Creates a new entity extraction job using a structured schema (multi-column) on the specified files"
        },
        {
          "info": {
            "name": "Get multi-dimensional extraction job",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "/api/core/multi-dim-extraction/jobs/:jobId",
            "params": [
              {
                "name": "jobId",
                "value": "",
                "type": "path",
                "description": "The job Id"
              }
            ]
          },
          "docs": "Returns a single multi-dimensional extraction job by its ID"
        },
        {
          "info": {
            "name": "Get multi-dimensional extraction job outputs",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "/api/core/multi-dim-extraction/jobs/:jobId/results",
            "params": [
              {
                "name": "jobId",
                "value": "",
                "type": "path",
                "description": "The job Id"
              }
            ]
          },
          "docs": "Returns the entity extraction results from the multi-dimensional extraction job"
        },
        {
          "info": {
            "name": "Get multi-dimensional extraction job inputs",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "/api/core/multi-dim-extraction/jobs/:jobId/inputs",
            "params": [
              {
                "name": "jobId",
                "value": "",
                "type": "path",
                "description": "The job Id"
              }
            ]
          },
          "docs": "Returns the input files and entity schema used for the multi-dimensional extraction job"
        },
        {
          "info": {
            "name": "Get multi-dimensional extraction job annotations",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "/api/core/multi-dim-extraction/jobs/:jobId/annotations",
            "params": [
              {
                "name": "jobId",
                "value": "",
                "type": "path",
                "description": "The job Id"
              }
            ]
          },
          "docs": "Returns the document annotations generated by the multi-dimensional extraction job"
        }
      ]
    }
  ],
  "bundled": true
}